// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Survey {
    id             String       @id @default(auto()) @map("_id") @db.ObjectId
    clientSurveyId String?      @unique
    deviceId       String
    location       String
    answer         SurveyAnswer
    timestamp      DateTime
    deviceInfo     DeviceInfo
    syncStatus     SyncStatus   @default(PENDING)
    retryCount     Int          @default(0)
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt

    // Relations
    device Device? @relation(fields: [deviceId], references: [deviceId])

    // Indexes
    @@index([deviceId, timestamp])
    @@index([location, createdAt])
    @@index([syncStatus])
    @@map("surveys")
}

model Device {
    id            String        @id @default(auto()) @map("_id") @db.ObjectId
    deviceId      String        @unique
    location      String
    name          String
    status        DeviceStatus  @default(ACTIVE)
    lastSeen      DateTime?
    configuration Configuration
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    // Relations
    surveys Survey[]

    @@index([location])
    @@index([status])
    @@map("devices")
}

model User {
    id               String    @id @default(auto()) @map("_id") @db.ObjectId
    email            String    @unique
    name             String
    password         String
    role             UserRole  @default(VIEWER)
    permissions      String[]
    organization     String?
    isActive         Boolean   @default(true)
    lastLogin        DateTime?
    loginAttempts    Int       @default(0)
    lockUntil        DateTime?
    resetToken       String?
    resetTokenExpiry DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    // Relations
    sessions Session[]

    @@index([role])
    @@index([isActive])
    @@map("users")
}

model Session {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    userId       String   @db.ObjectId
    sessionToken String   @unique
    refreshToken String   @unique
    deviceInfo   String?
    ipAddress    String?
    userAgent    String?
    isActive     Boolean  @default(true)
    expiresAt    DateTime
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@map("sessions")
}

model AuditLog {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    userId     String?  @db.ObjectId
    action     String
    resource   String
    resourceId String?
    details    Json?
    ipAddress  String?
    userAgent  String?
    timestamp  DateTime @default(now())

    @@index([userId, timestamp])
    @@index([action])
    @@index([resource])
    @@index([timestamp])
    @@map("audit_logs")
}

// Embedded types
type DeviceInfo {
    model      String
    os         String
    version    String
    appVersion String
}

type Configuration {
    surveyInterval Int    @default(30) // seconds
    theme          String @default("default")
    language       String @default("en")
}

// Enums
enum SurveyAnswer {
    EXCELLENT
    SATISFACTORY
    AVERAGE
}

enum SyncStatus {
    SYNCED
    PENDING
    FAILED
}

enum DeviceStatus {
    ACTIVE
    INACTIVE
    MAINTENANCE
}

enum UserRole {
    SUPER_ADMIN
    ADMIN
    VIEWER
}
